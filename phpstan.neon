includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
            message: '#App\\Concerns\\ProfileValidationRules#'
            # resources/views 配下の Livewire 単一ファイルコンポーネント
            # （settings/profile.blade.php）でのみ使用しており、
            # resources/views は paths に含まれないため誤検知となる。
